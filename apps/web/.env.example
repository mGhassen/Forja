VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Public release CDN (Cloudflare R2). Falls back to root RELEASE_CDN_URL via vite.config.
# VITE_RELEASE_CDN_URL=https://downloads.example.com

# Cloudflare Turnstile site key (public). Required when Auth captcha is enabled.
# Local always-pass dummy (matches apps/web/supabase/config.toml captcha secret):
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Production: paste the site key from your Cloudflare Turnstile widget.

# Optional OAuth providers (comma-separated). Empty = hide OAuth buttons.
# Enable the same providers in Supabase Auth → Providers, and add redirect
# `https://<portal>/auth/callback` (plus http://127.0.0.1:3000/auth/callback for local).
# VITE_AUTH_OAUTH_PROVIDERS=google

# Desktop app Web login uses FORJA_WEB_URL in the *repo-root* `.env` (and the
# GitHub secret of the same name for release) — not this file. This portal does
# not need to know its own public URL to serve pages.

# Local Docker (forja-dev, ports 55321+):
# VITE_SUPABASE_URL=http://127.0.0.1:55321
# VITE_SUPABASE_PUBLISHABLE_KEY=<PUBLISHABLE_KEY from `supabase status` in apps/web>
