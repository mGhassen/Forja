VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Same Turnstile site key as apps/web (hosted Auth captcha).
# VITE_TURNSTILE_SITE_KEY=…
# Or rely on repo-root TURNSTILE_SITE_KEY via vite.config bridge.

# Optional OAuth (shared @forja/auth). Same as apps/web — enable providers in
# Supabase Auth and add redirect `https://admin…/auth/callback`.
# VITE_AUTH_OAUTH_PROVIDERS=google

# Server-only — IPTV catalog Inngest scrape (never VITE_*)
# Comma-separated Reddit installed-app client IDs (also set on Vercel).
# REDDIT_CLIENT_IDS=
# SUPABASE_SERVICE_ROLE_KEY=
# Falls back to repo-root SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY via vite.config.
# INNGEST_EVENT_KEY=          # required on Vercel (Inngest → Event keys)
# INNGEST_SIGNING_KEY=        # required on Vercel (Inngest → Signing key)
# INNGEST_SERVE_ORIGIN=https://admin.forjahq.xyz
#   Prod: set on Vercel so Inngest Cloud syncs the custom domain
#   (not protected *.vercel.app). Code defaults to this on Vercel if unset.
# Local only (never set on Vercel):
# INNGEST_DEV=1
#   npx inngest-cli@latest dev -u http://127.0.0.1:4000/api/inngest
#
# Optional — LLM extract is OFF unless IPTV_LLM_EXTRACT=1 (key alone does nothing):
# ANTHROPIC_API_KEY=
# IPTV_LLM_MODEL=claude-haiku-4-5-20251001
# IPTV_LLM_EXTRACT=1
# Agent: apps/admin/src/server/iptv-catalog/agent/ (opt-in only; errors never fail scrape)

# Server-only — PostHog persons on Accounts (never VITE_*).
# Personal API key with person:read (+ query:read).
# POSTHOG_PROJECT_ID = numeric Project ID *or* project API token (phc_…) — phc_ is
# resolved to the numeric id via GET /api/projects/.
# POSTHOG_PERSONAL_API_KEY=
# POSTHOG_PROJECT_ID=
# POSTHOG_HOST=https://us.i.posthog.com
#   EU: https://eu.i.posthog.com
