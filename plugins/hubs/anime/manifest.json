{
  "schema": 1,
  "id": "forjahq-anime",
  "name": "ForjaHQ Anime",
  "description": "AniList-powered anime hub with search and details.",
  "author": "ForjaHQ",
  "version": "1.0.10",
  "plugins": [
    {
      "id": "anilist",
      "name": "Anime",
      "description": "AniList anime hub",
      "entry": "anilist.js",
      "kind": "catalog",
      "protocol": 1,
      "kit": 1,
      "types": [
        "anime"
      ],
      "capabilities": [
        "nav",
        "layout",
        "feed",
        "rail",
        "search",
        "filters",
        "details"
      ],
      "nav": {
        "tabId": "anime",
        "label": "Anime",
        "order": 20,
        "icon": "forja://asset/nav/anime",
        "accent": "#FB7185",
        "defaultEnabled": true
      },
      "enabled": true,
      "enrich": "anime-enrich-tmdb",
      "config": {
        "graphql": "https://graphql.anilist.co",
        "perPage": 24
      },
      "prelude": "_kit.js"
    },
    {
      "id": "anime-enrich-tmdb",
      "name": "TMDB Enrich",
      "description": "TMDB match enrich for Anime metas (companion to AniList)",
      "entry": "enrich_tmdb.js",
      "kind": "catalog",
      "protocol": 1,
      "kit": 1,
      "types": [
        "anime"
      ],
      "capabilities": [
        "enrich"
      ],
      "enabled": true,
      "config": {
        "rails": [
          "spotlight"
        ],
        "limit": 5
      },
      "prelude": "_kit.js"
    }
  ]
}
