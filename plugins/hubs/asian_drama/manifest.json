{
  "schema": 1,
  "id": "forjahq-asian-drama",
  "name": "ForjaHQ Asian Drama",
  "description": "KissKH Asian drama catalog hub.",
  "author": "ForjaHQ",
  "version": "1.0.9",
  "tags": [
    "asian-drama",
    "drama"
  ],
  "plugins": [
    {
      "id": "kisskh-hub",
      "name": "Asian Drama",
      "description": "KissKH Asian drama hub",
      "entry": "kisskh.js",
      "kind": "catalog",
      "protocol": 1,
      "kit": 1,
      "types": [
        "drama"
      ],
      "capabilities": [
        "nav",
        "layout",
        "rail",
        "search",
        "details",
        "filters",
        "feed"
      ],
      "nav": {
        "tabId": "asian_drama",
        "label": "Asian Drama",
        "order": 30,
        "icon": "icons/nav.png",
        "accent": "#C4B5FD"
      },
      "enabled": true,
      "enrich": "enrich-tmdb",
      "config": {
        "base": "https://kisskh.co",
        "mirrors": [
          "https://kisskh.co",
          "https://kisskh.nl",
          "https://kisskh.ovh",
          "https://kisskh.la",
          "https://kisskh.do",
          "https://kisskh.is",
          "https://kisskh.id"
        ]
      },
      "prelude": "_kit.js"
    },
    {
      "id": "enrich-tmdb",
      "name": "TMDB Enrich",
      "description": "TMDB match enrich for Asian Drama metas (companion to KissKH)",
      "entry": "enrich_tmdb.js",
      "kind": "catalog",
      "protocol": 1,
      "kit": 1,
      "types": [
        "drama"
      ],
      "capabilities": [
        "enrich"
      ],
      "enabled": true,
      "config": {
        "rails": [
          "spotlight"
        ],
        "limit": 5
      },
      "prelude": "_kit.js"
    }
  ],
  "bundle": [
    "kisskh.js",
    "_kit.js",
    "enrich_tmdb.js"
  ]
}
