{
  "schema": 1,
  "id": "forjahq-home",
  "name": "ForjaHQ Home",
  "description": "TMDB movie and TV catalog for the Home tab.",
  "author": "ForjaHQ",
  "version": "1.0.20",
  "tags": [
    "home",
    "movies",
    "tv"
  ],
  "plugins": [
    {
      "id": "tmdb",
      "name": "Home",
      "description": "TMDB movie / TV hub",
      "entry": "tmdb.js",
      "kind": "catalog",
      "protocol": 1,
      "kit": 1,
      "types": [
        "movie",
        "tv"
      ],
      "capabilities": [
        "nav",
        "layout",
        "rail",
        "search",
        "host_search",
        "structured_search",
        "filters"
      ],
      "nav": {
        "label": "Home",
        "icon": "icons/nav.png",
        "accent": "#1CE783"
      },
      "config": {
        "base": "https://db.speedracelight.com/3",
        "imageBase": "https://image.tmdb.org/t/p",
        "apiKey": "",
        "pageSize": 20
      },
      "prelude": "_kit.js"
    }
  ],
  "bundle": [
    "tmdb.js",
    "_kit.js"
  ]
}
