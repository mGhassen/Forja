{
  "schema": 1,
  "id": "forjahq-live-sports",
  "name": "ForjaHQ Live Sports",
  "description": "Live sports list with a streams panel.",
  "author": "ForjaHQ",
  "version": "1.0.4",
  "tags": [
    "sports",
    "live"
  ],
  "plugins": [
    {
      "id": "live-sports-hub",
      "name": "Live Sports",
      "description": "Live sports list with a streams panel.",
      "entry": "live_sports.js",
      "kind": "catalog",
      "protocol": 1,
      "kit": 1,
      "types": [
        "live_match"
      ],
      "capabilities": [
        "nav",
        "layout",
        "settings"
      ],
      "nav": {
        "tabId": "live_matches",
        "label": "Live Sports",
        "order": 20,
        "icon": "icons/nav.png",
        "accent": "#FB923C"
      },
      "settings": {
        "addon": "live_sports",
        "group": "Live Sports",
        "order": 20,
        "fields": [
          {
            "id": "mergeMatchingEvents",
            "type": "toggle",
            "label": "Merge matching events",
            "subtitle": "Combine the same game across catalogs and run ESPN enrich. Off is faster with large schedules (default).",
            "default": false
          }
        ]
      },
      "prelude": "_kit.js"
    }
  ],
  "bundle": [
    "live_sports.js",
    "_kit.js"
  ]
}
