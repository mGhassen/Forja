{
  "schema": 1,
  "id": "forjahq-my-list",
  "name": "ForjaHQ My List",
  "description": "Personal watchlists: local bookmarks and Simkl sync.",
  "author": "ForjaHQ",
  "version": "1.0.2",
  "tags": [
    "lists"
  ],
  "plugins": [
    {
      "id": "my-list-hub",
      "name": "My List",
      "description": "Personal watchlists — local bookmarks and Simkl sync",
      "entry": "my_list.js",
      "kind": "catalog",
      "protocol": 1,
      "kit": 1,
      "types": [
        "list"
      ],
      "capabilities": [
        "nav",
        "layout"
      ],
      "enrich": "my-list-enrich-tmdb",
      "nav": {
        "tabId": "mylist",
        "label": "My List",
        "order": 15,
        "icon": "forja://asset/nav/my-list",
        "accent": "#FBBF24"
      },
      "prelude": "_kit.js"
    },
    {
      "id": "my-list-enrich-tmdb",
      "name": "My List TMDB enrich",
      "description": "TMDB hydrate for My List legacy rows (companion to my-list-hub)",
      "entry": "enrich_tmdb.js",
      "kind": "catalog",
      "protocol": 1,
      "kit": 1,
      "capabilities": [
        "enrich"
      ],
      "prelude": "_kit.js"
    }
  ],
  "bundle": [
    "my_list.js",
    "_kit.js",
    "enrich_tmdb.js"
  ]
}
