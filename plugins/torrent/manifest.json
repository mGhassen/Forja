{
  "schema": 1,
  "id": "forjahq-torrent",
  "name": "ForjaHQ Torrent",
  "description": "Built-in torrent indexer search for movies and series.",
  "author": "ForjaHQ",
  "version": "1.0.7",
  "prelude": "_torrent_common.js",
  "tags": ["torrent"],
  "plugins": [
    {
      "id": "knaben",
      "name": "Knaben",
      "entry": "knaben.js",
      "kind": "torrent",
      "searchInputs": ["query"],
      "config": { "source": "Knaben" }
    },
    {
      "id": "pirate_bay",
      "name": "The Pirate Bay",
      "entry": "pirate_bay.js",
      "kind": "torrent",
      "searchInputs": ["query"],
      "config": { "source": "ThePirateBay" }
    },
    {
      "id": "uindex",
      "name": "UIndex",
      "entry": "uindex.js",
      "kind": "torrent",
      "searchInputs": ["query"],
      "config": { "source": "UIndex" }
    },
    {
      "id": "torrents_csv",
      "name": "Torrents CSV",
      "entry": "torrents_csv.js",
      "kind": "torrent",
      "searchInputs": ["query"],
      "config": { "source": "Torrents CSV" }
    },
    {
      "id": "nyaa",
      "name": "Nyaa",
      "entry": "nyaa.js",
      "kind": "torrent",
      "searchInputs": ["query"],
      "config": { "source": "Nyaa" }
    },
    {
      "id": "yts",
      "name": "YTS",
      "entry": "yts.js",
      "kind": "torrent",
      "searchInputs": ["query"],
      "config": { "source": "YTS" }
    },
    {
      "id": "solid_torrents",
      "name": "SolidTorrents",
      "entry": "solid_torrents.js",
      "kind": "torrent",
      "searchInputs": ["query"],
      "config": { "source": "SolidTorrents" }
    },
    {
      "id": "therarbg",
      "name": "TheRARBG",
      "entry": "therarbg.js",
      "kind": "torrent",
      "searchInputs": ["query"],
      "config": { "source": "TheRARBG" }
    },
    {
      "id": "torrentio",
      "name": "Torrentio",
      "entry": "torrentio.js",
      "kind": "torrent",
      "searchInputs": ["imdbId"],
      "config": { "source": "Torrentio" }
    }
  ]
}
