{
  "schema": 1,
  "id": "forjahq-live",
  "name": "ForjaHQ Live Sports Streams",
  "description": "Live Sports per-site stream resolve (Forja Live).",
  "author": "ForjaHQ",
  "version": "1.11.0",
  "tags": [
    "live",
    "sports"
  ],
  "plugins": [
    {
      "id": "live-streamed",
      "name": "Streamed",
      "description": "streamed.pk stream resolve (GOAT / golf)",
      "entry": "streamed.js",
      "types": [
        "live"
      ],
      "kind": "http",
      "prelude": "embed-st.js",
      "config": {
        "origin": "https://streamed.pk",
        "embedOrigin": "https://embed.st",
        "nativeUnlock": "streamed"
      }
    },
    {
      "id": "live-ppv",
      "name": "PPV",
      "description": "ppv.st / api.ppv.st stream resolve",
      "entry": "ppv.js",
      "types": [
        "live"
      ],
      "kind": "http",
      "prelude": "embed-st.js",
      "config": {
        "webOrigin": "https://ppv.st",
        "nativeUnlock": "ppv",
        "apis": [
          "https://api.ppv.st/api/streams",
          "https://api.ppv.cx/api/streams",
          "https://api.ppv.is/api/streams",
          "https://api.ppv.lc/api/streams",
          "https://api.ppv.tj/api/streams",
          "https://api.ppvs.pk/api/streams",
          "https://api.ppv.rw/api/streams",
          "https://api.ppv.ms/api/streams",
          "https://api.ppv.bi/api/streams",
          "https://api.ppv.ug/api/streams"
        ]
      }
    },
    {
      "id": "live-streamfree",
      "name": "StreamFree",
      "description": "streamfree.top stream resolve",
      "entry": "streamfree.js",
      "types": [
        "live"
      ],
      "kind": "http",
      "prelude": "embed-st.js",
      "config": {
        "origin": "https://streamfree.top",
        "embedOrigin": "https://embed.st"
      }
    },
    {
      "id": "live-timstreams",
      "name": "TimStreams",
      "description": "timstreams.st stream resolve",
      "entry": "timstreams.js",
      "types": [
        "live"
      ],
      "kind": "http",
      "prelude": "embed-st.js",
      "config": {
        "origin": "https://timstreams.st",
        "embedOrigin": "https://embed.st"
      }
    },
    {
      "id": "live-watchfooty",
      "name": "WatchFooty",
      "description": "watchfooty.st stream resolve",
      "entry": "watchfooty.js",
      "types": [
        "live"
      ],
      "kind": "http",
      "prelude": "embed-st.js",
      "config": {
        "origin": "https://watchfooty.st",
        "nativeUnlock": "watchfooty",
        "airingOnlyLive": true
      }
    },
    {
      "id": "live-streamic",
      "name": "Streamic",
      "description": "streamic.live stream resolve",
      "entry": "streamic.js",
      "types": [
        "live"
      ],
      "kind": "http",
      "prelude": "embed-st.js",
      "config": {
        "origin": "https://streamic.st",
        "api": "https://streamic.st/api/getEvents.php",
        "popularApi": "https://streamic.st/api/J.php",
        "ssig": "bytmo8xialhem066",
        "embedOrigin": "https://embed.st",
        "ppvOrigin": "https://ppv.st",
        "ppvApis": [
          "https://api.ppv.st/api/streams",
          "https://api.ppv.cx/api/streams",
          "https://api.ppv.is/api/streams",
          "https://api.ppv.lc/api/streams",
          "https://api.ppv.tj/api/streams",
          "https://api.ppvs.pk/api/streams",
          "https://api.ppv.rw/api/streams",
          "https://api.ppv.ms/api/streams",
          "https://api.ppv.bi/api/streams",
          "https://api.ppv.ug/api/streams"
        ]
      }
    },
    {
      "id": "live-mobikora",
      "name": "MobiKora",
      "description": "mobikora.live stream resolve",
      "entry": "mobikora.js",
      "types": [
        "live"
      ],
      "kind": "http",
      "prelude": "embed-st.js",
      "config": {
        "origin": "https://mobikora.live",
        "matchIdPrefix": "mk_"
      }
    }
  ],
  "bundle": [
    "streamed.js",
    "embed-st.js",
    "ppv.js",
    "streamfree.js",
    "timstreams.js",
    "watchfooty.js",
    "streamic.js",
    "mobikora.js",
    "goat/unlock.mjs",
    "goat/package.json",
    "goat/vendor/lock.wasm",
    "goat/vendor/lock-esm.mjs",
    "goat/vendor/big-integer.min.js",
    "goat/webview/crack.js",
    "goat/webview/unlock.html",
    "goat/webview/proxy_fetch.js",
    "gasm/unlock.mjs",
    "gasm/sniff.mjs",
    "gasm/package.json",
    "gasm/vendor/gasm.wasm",
    "gasm/vendor/gasm.js",
    "gasm/vendor/gasm-live.wasm",
    "gasm/vendor/gasm-live.js",
    "gasm/vendor/gasm-esm.mjs",
    "gasm/webview/crack.js",
    "gasm/webview/unlock.html",
    "sportsembed/unlock.mjs",
    "sportsembed/vendor/stream-lock.wasm"
  ]
}
