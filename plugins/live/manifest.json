{
  "schema": 1,
  "id": "forjahq-live",
  "name": "ForjaHQ Live Sports",
  "version": "1.6.0",
  "plugins": [
    {
      "id": "streamed",
      "name": "Streamed",
      "description": "streamed.pk schedule + stream resolve (GOAT / golf)",
      "entry": "streamed.js",
      "types": ["live_sport"],
      "capabilities": ["catalog", "resolve"],
      "kind": "http",
      "prelude": "embed-st.js",
      "config": {
        "origin": "https://streamed.pk",
        "embedOrigin": "https://embed.st",
        "nativeUnlock": "streamed"
      }
    },
    {
      "id": "ppv",
      "name": "PPV",
      "description": "ppv.st schedule + stream resolve",
      "entry": "ppv.js",
      "types": ["live_sport"],
      "capabilities": ["catalog", "resolve"],
      "kind": "http",
      "prelude": "embed-st.js",
      "config": {
        "webOrigin": "https://ppv.st",
        "nativeUnlock": "ppv",
        "apis": [
          "https://api.ppv.st/api/streams",
          "https://api.ppv.cx/api/streams"
        ]
      }
    },
    {
      "id": "streamfree",
      "name": "StreamFree",
      "description": "streamfree.top schedule + stream resolve",
      "entry": "streamfree.js",
      "types": ["live_sport"],
      "capabilities": ["catalog", "resolve"],
      "kind": "http",
      "prelude": "embed-st.js",
      "config": {
        "origin": "https://streamfree.top"
      }
    },
    {
      "id": "timstreams",
      "name": "TimStreams",
      "description": "timstreams.st schedule + stream resolve",
      "entry": "timstreams.js",
      "types": ["live_sport"],
      "capabilities": ["catalog", "resolve"],
      "kind": "http",
      "prelude": "embed-st.js",
      "config": {
        "origin": "https://timstreams.st",
        "api": "https://timstreams.st/api/live-upcoming",
        "embedOrigin": "https://embed.st"
      }
    },
    {
      "id": "watchfooty",
      "name": "WatchFooty",
      "description": "watchfooty.st schedule + stream resolve",
      "entry": "watchfooty.js",
      "types": ["live_sport"],
      "capabilities": ["catalog", "resolve"],
      "kind": "http",
      "prelude": "embed-st.js",
      "config": {
        "origin": "https://watchfooty.st",
        "nativeUnlock": "watchfooty",
        "airingOnlyLive": true
      }
    },
    {
      "id": "streamic",
      "name": "Streamic",
      "description": "streamic.live schedule + stream resolve",
      "entry": "streamic.js",
      "types": ["live_sport"],
      "capabilities": ["catalog", "resolve"],
      "kind": "http",
      "prelude": "embed-st.js",
      "config": {
        "origin": "https://streamic.st"
      }
    },
    {
      "id": "espn",
      "name": "ESPN",
      "description": "ESPN scoreboard schedule catalog",
      "entry": "espn.js",
      "types": ["live_sport"],
      "capabilities": ["catalog"],
      "kind": "http",
      "config": {
        "leagues": [
          "NBA",
          "NFL",
          "MLB",
          "NHL",
          "WNBA",
          "NCAAMB",
          "NCAAWB",
          "NCAAFB",
          "EPL",
          "MLS",
          "LALIGA",
          "SERIEA",
          "BUNDESLIGA",
          "LIGUE1",
          "UCL",
          "EUROPA",
          "EREDIVISIE",
          "LIGAPORTUGAL",
          "LIGAMX",
          "WORLDCUP",
          "UFC"
        ]
      }
    }
  ]
}
