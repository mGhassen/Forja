{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "additionalDirectories": ["../forja-packs"],
    "allow": [
      "Read(**)",
      "Edit(apps/**)",
      "Edit(packages/**)",
      "Edit(crates/**)",
      "Edit(docs/**)",
      "Edit(scripts/**)",
      "Edit(.cursor/**)",
      "Edit(.claude/**)",
      "Edit(CLAUDE.md)",
      "Edit(.mcp.json)",
      "Bash(flutter analyze*)",
      "Bash(flutter test*)",
      "Bash(flutter pub get*)",
      "Bash(flutter pub outdated*)",
      "Bash(flutter --version*)",
      "Bash(flutter doctor*)",
      "Bash(dart format*)",
      "Bash(dart analyze*)",
      "Bash(dart run build_runner*)",
      "Bash(dart run custom_lint*)",
      "Bash(dart --version*)",
      "Bash(cargo build*)",
      "Bash(cargo check*)",
      "Bash(cargo test*)",
      "Bash(cargo clippy*)",
      "Bash(cargo fmt*)",
      "Bash(cargo tree*)",
      "Bash(cargo metadata*)",
      "Bash(rustfmt*)",
      "Bash(melos bootstrap*)",
      "Bash(melos run analyze*)",
      "Bash(melos run test*)",
      "Bash(melos run rust:test*)",
      "Bash(melos run rust:build*)",
      "Bash(melos run rust:check-*)",
      "Bash(melos list*)",
      "Bash(./scripts/check_*)",
      "Bash(scripts/check_*)",
      "Bash(./scripts/build_rust.sh*)",
      "Bash(./scripts/audit-engine-plugins.sh*)",
      "Bash(./scripts/foundation_export_inventory.sh*)",
      "Bash(pnpm install*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm build*)",
      "Bash(pnpm --filter *)",
      "Bash(supabase migration new *)",
      "Bash(supabase migration list*)",
      "Bash(supabase status*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git branch*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(git worktree list*)",
      "Bash(git worktree add --detach *)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh release list*)",
      "Bash(gh release view*)",
      "Bash(gh api repos/*)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(sed -n *)",
      "Bash(awk *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(diff *)",
      "Bash(jq *)",
      "Bash(python3 -I *)",
      "Bash(which *)",
      "Bash(command -v *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(pwd)",
      "Bash(date*)",
      "Bash(mkdir *)",
      "Bash(chmod +x *)",
      "Bash(bash .claude/hooks/*)",
      "WebFetch(domain:docs.flutter.dev)",
      "WebFetch(domain:api.flutter.dev)",
      "WebFetch(domain:pub.dev)",
      "WebFetch(domain:dart.dev)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:crates.io)",
      "WebFetch(domain:doc.rust-lang.org)",
      "WebFetch(domain:supabase.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:code.claude.com)",
      "mcp__dart__*",
      "mcp__context7__*"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git add*)",
      "Bash(git tag*)",
      "Bash(git rebase*)",
      "Bash(git merge*)",
      "Bash(git cherry-pick*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git worktree remove*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh issue create*)",
      "Bash(gh release*)",
      "Bash(gh workflow run*)",
      "Bash(./scripts/release_*)",
      "Bash(./scripts/bump_version.sh*)",
      "Bash(./scripts/changelog_freeze.sh*)",
      "Bash(./scripts/changelog_release_notes.sh*)",
      "Bash(./scripts/build_rust_mobile.sh*)",
      "Bash(./scripts/build_macos.sh*)",
      "Bash(./scripts/package_*)",
      "Bash(flutter build*)",
      "Bash(flutter run*)",
      "Bash(flutter clean*)",
      "Bash(supabase *)",
      "Bash(pnpm dev*)",
      "Bash(npx *)",
      "Bash(rm *)",
      "Edit(apps/web/supabase/migrations/**)",
      "Edit(.github/**)",
      "Edit(installer/**)",
      "Edit(.cursor/skills/**)",
      "Edit(.cursor/rules/**)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.production)",
      "Read(apps/web/.env)",
      "Read(apps/web/.env.local)",
      "Read(**/key.properties)",
      "Read(**/release.keystore)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(docs/backlog/**)",
      "Edit(docs/changelog/done/**)",
      "Edit(apps/forja/lib/shared/foundation/**)",
      "Edit(.claude/skills/**)",
      "Edit(nuget.exe)",
      "Edit(**/pubspec.lock)",
      "Edit(**/Cargo.lock)",
      "Edit(**/pnpm-lock.yaml)",
      "Bash(supabase db reset*)",
      "Bash(supabase db push*)",
      "Bash(supabase db remote*)",
      "Bash(supabase link*)",
      "Bash(node scripts/reset-forja-supabase.js*)",
      "Bash(node ../../scripts/reset-forja-supabase.js*)",
      "Bash(pnpm supabase:reset*)",
      "Bash(git stash*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git branch -D*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(sudo *)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "WebFetch(domain:*.r2.dev)"
    ]
  },
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": ["dart", "context7"],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh", "timeout": 20 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh", "timeout": 10 }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-edit.sh", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit.sh", "timeout": 60 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-changelog.sh", "timeout": 15 }
        ]
      }
    ]
  }
}
