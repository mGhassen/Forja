# Copy to `.env` at the repo root (gitignored) and fill in values.
# Loaded at Rust compile time by crates/tmdb + crates/webstreamr + crates/anime.
#
#   cp .env.example .env
#
# CI / release: repo secrets TMDB_API_KEY + TMDB_READ_ACCESS_TOKEN + WYZIE_API_KEY
# + SUPABASE_URL + SUPABASE_PUBLISHABLE_KEY
# (wired in .github/workflows/{build,release,rust}.yml; process env overrides `.env`).

TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
WYZIE_API_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional: Forja web portal origin used by desktop "Web login" / signup links.
# Defaults to http://127.0.0.1:3000 (local `pnpm --filter web dev`).
# FORJA_WEB_URL=https://your-portal.example
# Optional aliases for apps/web (Vite). If omitted, apps/web/vite.config.ts
# falls back to the SUPABASE_* keys above when apps/web/.env has no VITE_*.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase DB (operators): encrypt IPTV portal passwords at rest.
# Set on the Postgres database (not a Vite env):
#   alter database postgres set app.settings.iptv_portal_key = '<long-random-secret>';
# Local `supabase db reset` uses a built-in dev fallback until you set this.
