# Copy to `.env` at the repo root (gitignored) and fill in values.
# Loaded at Rust compile time by crates/tmdb + crates/subtitles.
# Flutter desktop loads the same file via:
#   flutter run -d macos --dart-define-from-file=../../.env
#
#   cp .env.example .env
#
# CI / release: repo secrets TMDB_API_KEY + TMDB_READ_ACCESS_TOKEN + WYZIE_API_KEY
# + REDDIT_CLIENT_IDS + SUPABASE_URL + SUPABASE_PUBLISHABLE_KEY + RELEASE_CDN_URL
# + FORJA_WEB_URL + TURNSTILE_SITE_KEY + R2_ACCESS_KEY_ID + R2_SECRET_ACCESS_KEY
# + SENTRY_DSN + SIMKL_CLIENT_ID
# (wired in .github/workflows/{build,release,rust}.yml; process env overrides `.env`).

TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
WYZIE_API_KEY=

# Reddit installed-app client IDs (comma-separated). Used by IPTV catalog scrape
# (Rust compile-time + admin Inngest). Never commit real values.
# GitHub secret REDDIT_CLIENT_IDS; Vercel (admin) env REDDIT_CLIENT_IDS.
REDDIT_CLIENT_IDS=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Public release CDN (Cloudflare R2 custom domain or pub-*.r2.dev).
# Flutter: --dart-define=RELEASE_CDN_URL=…  Web: VITE_RELEASE_CDN_URL
RELEASE_CDN_URL=
# CI only (GitHub secrets — never put access keys in Flutter / Vite):
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY upload installers to R2.
# Admin Downloads page: daily Inngest rolls CF Analytics into R2
# stats/downloads.json (lifetime). Needs Analytics Read token + S3 keys.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_API_TOKEN=
# R2_BUCKET=forja-releases

# Desktop "Web login" / signup portal origin (Flutter --dart-define).
# Local: Vite at apps/web (`pnpm --filter web dev`).
# Release: set GitHub secret FORJA_WEB_URL to the deployed portal
# (e.g. https://your-app.vercel.app) — required; CI fails without it.
FORJA_WEB_URL=http://127.0.0.1:3000

# ForjaHQ pack manifests (dev reference + Rust audit-engine-plugins).
# Host does not auto-install from these — paste URLs in Settings → Sources → Forja
# or sync pack rows from your signed-in profile.
# Debug builds: when FORJA_REPO_ROOT (or FORJA_HQ_TORRENT_MANIFEST_URL) is passed via
# `--dart-define-from-file=../../.env`, the app auto-installs the local torrent pack
# if no torrent slot pack is installed yet.
# FORJA_REPO_ROOT=/path/to/Forja
# FORJA_HQ_PROVIDERS_MANIFEST_URL=/path/to/Forja/plugins/providers/manifest.json
# FORJA_HQ_LIVE_MANIFEST_URL=/path/to/Forja/plugins/live/manifest.json
# FORJA_HQ_HOME_MANIFEST_URL=/path/to/Forja/plugins/hubs/home/manifest.json
# FORJA_HQ_ANIME_MANIFEST_URL=/path/to/Forja/plugins/hubs/anime/manifest.json
# FORJA_HQ_ASIAN_DRAMA_MANIFEST_URL=/path/to/Forja/plugins/hubs/asian_drama/manifest.json
# FORJA_HQ_MY_LIST_MANIFEST_URL=/path/to/Forja/plugins/hubs/my_list/manifest.json
# FORJA_HQ_IPTV_VOD_MANIFEST_URL=/path/to/Forja/plugins/iptv/vod/manifest.json
# FORJA_HQ_TORRENT_MANIFEST_URL=/path/to/Forja/plugins/torrent/manifest.json

# Cloudflare Turnstile site key (public). Required when Auth captcha is enabled
# on the Supabase project — desktop email/password login embeds the widget.
# Local always-pass dummy (matches apps/web + supabase/config.toml):
TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Hosted: same site key as VITE_TURNSTILE_SITE_KEY / Vercel.
# Optional GitHub secret TURNSTILE_SITE_KEY for release builds.

# Optional aliases for apps/web (Vite). If omitted, apps/web/vite.config.ts
# falls back to the SUPABASE_* keys above when apps/web/.env has no VITE_*.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional Sentry DSN for crash reporting (RFC-043). Empty uses the baked-in
# Forja Flutter project default; override for staging / alternate orgs.
# Flutter: --dart-define=SENTRY_DSN=…
# Opt-in still required in Settings → About → Crash reporting.
# Also set GitHub secret SENTRY_DSN for release CI (optional — default works).
SENTRY_DSN=

# PostHog — Flutter app product analytics (RFC-043). Empty = SDK never starts.
# Project API key from PostHog → Project settings. Host: US or EU cloud.
# Flutter: --dart-define=POSTHOG_API_KEY=… --dart-define=POSTHOG_HOST=…
# Opt-in: Settings → About → Product analytics.
# Web portal uses a *separate* PostHog project — set VITE_POSTHOG_KEY in
# apps/web/.env / Vercel (never reuse this app key).
# GitHub secrets: POSTHOG_API_KEY (+ optional POSTHOG_HOST).
# Admin Accounts persons (server-only on apps/admin / Vercel admin):
#   POSTHOG_PERSONAL_API_KEY=phx_…  (Personal API key: person:read + query:read)
#   POSTHOG_PROJECT_ID=             (numeric id OR project phc_… — same Flutter project)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# Simkl (Settings → Connected services). PIN login needs the client ID.
# Register at https://simkl.com/settings/developer then:
# Flutter: --dart-define=SIMKL_CLIENT_ID=…  (also via --dart-define-from-file=.env)
# GitHub secret SIMKL_CLIENT_ID for release CI.
SIMKL_CLIENT_ID=
# Unused by the PIN flow; keep if you add other Simkl OAuth later.
# SIMKL_CLIENT_SECRET=

# Trakt — admin-only in Settings. Same dart-define / .env pattern.
# Register at https://trakt.tv/oauth/applications
# Redirect URI: urn:ietf:wg:oauth:2.0:oob
# TRAKT_CLIENT_ID=
# TRAKT_CLIENT_SECRET=

# Supabase DB (operators): encrypt IPTV portal passwords at rest.
# Set on the Postgres database (not a Vite env):
#   alter database postgres set app.settings.iptv_portal_key = '<long-random-secret>';
# Local `supabase db reset` uses a built-in dev fallback until you set this.
