{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forja.app/plugins/sdk/schema/manifest.schema.json",
  "title": "Forja EngineJS pack manifest",
  "description": "Top-level manifest.json for a Forja plugin pack. Host parser: EnginePack.fromJson.",
  "type": "object",
  "required": ["schema", "id", "name", "version", "plugins"],
  "additionalProperties": true,
  "properties": {
    "schema": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "author": { "type": "string" },
    "description": { "type": "string" },
    "tags": {
      "type": "array",
      "description": "Catalog topic tags for web Community Packs filters (e.g. anime, arabic, kids). When omitted, the catalog generator derives tags from nav.tabId and topic types.",
      "items": { "type": "string", "minLength": 1 }
    },
    "prelude": {
      "type": "string",
      "minLength": 1,
      "description": "Shared JS prepended before every plugin entry in this pack."
    },
    "bundle": {
      "type": "array",
      "description": "Pack-relative script paths to download on install (entry/prelude files). Host fetches every listed file.",
      "items": { "type": "string", "minLength": 1 }
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/plugin" }
    }
  },
  "$defs": {
    "plugin": {
      "type": "object",
      "required": ["id", "name", "entry"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "entry": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "filename": {
          "type": "string",
          "description": "Legacy alias for entry."
        },
        "kind": {
          "type": "string",
          "enum": ["http", "hop", "catalog", "host", "torrent"],
          "default": "http"
        },
        "types": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "supportedTypes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Legacy alias for types."
        },
        "config": { "type": "object" },
        "prelude": { "type": "string", "minLength": 1 },
        "protocol": { "type": "integer", "minimum": 1 },
        "kit": { "type": "integer", "minimum": 1 },
        "capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "defaultCapabilities": {
          "type": "object",
          "description": "First-run Settings defaults for live_sport capability toggles (catalog, resolve).",
          "additionalProperties": { "type": "boolean" }
        },
        "legacyIds": {
          "type": "object",
          "description": "Retired twin-pack plugin ids for host migration (catalog-*, live-*).",
          "additionalProperties": false,
          "properties": {
            "catalog": { "type": "string", "minLength": 1 },
            "resolve": { "type": "string", "minLength": 1 }
          }
        },
        "nav": { "$ref": "#/$defs/nav" },
        "enrich": { "type": "string", "minLength": 1 },
        "hosts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "hostId": { "type": "string" },
        "ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "searchInputs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Torrent plugins: declared search inputs (query, imdbId, …)"
        },
        "ctxConfigMap": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "nav": {
      "type": "object",
      "required": ["tabId", "label"],
      "additionalProperties": true,
      "properties": {
        "tabId": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "order": { "type": "number" },
        "icon": {
          "type": "string",
          "minLength": 1,
          "description": "Pack-relative image (e.g. icons/nav.png) or forja://asset/… host glyph. Omit for Material default.",
          "not": {
            "anyOf": [
              { "pattern": "^assets/" },
              { "pattern": "\\.\\." }
            ]
          }
        },
        "accent": { "type": "string" }
      }
    }
  }
}
