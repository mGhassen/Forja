# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Local scratch / probe dumps (never ship)
.tmp/
.tmp_hls/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android signing
android/release.keystore
android/key.properties

# Local environment secrets (keep .env.example tracked)
.env
*.env
!.env.example
!apps/web/.env.example

# Generated platform folders (CI creates linux/ & macos/ on the fly)
/linux/
/macos/

# Inno Setup output
installer/windows/Output/

# Release packaging artifacts
/dist/

# Node (apps/web) — build/cache/deps (see also apps/web/.gitignore)
**/node_modules/
.pnpm-store/
apps/web/dist/
apps/web/dist-ssr/
apps/web/.vite/
apps/web/.output/
apps/web/.nitro/
apps/web/.tanstack/
apps/web/.vinxi/
apps/web/.wrangler/
apps/web/.netlify/
apps/web/.vercel/
apps/web/coverage/
apps/web/.env
apps/web/.env.*
!apps/web/.env.example
apps/web/.env.local

# Supabase CLI local cache (keep migrations/config tracked)
**/.temp/
apps/web/supabase/.branches/
